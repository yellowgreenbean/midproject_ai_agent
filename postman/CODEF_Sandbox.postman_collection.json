{
  "info": {
    "name": "CODEF Sandbox",
    "description": "CODEF 샌드박스 카드 목록 조회. client_id/client_secret 은 CODEF 공식 라이브러리(easycodef-java)에 공개된 샌드박스 공용 키입니다. 개발/운영 서버로 바꿀 때는 base_url 과 키를 본인 값으로 교체하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sandbox.codef.io" },
    { "key": "oauth_url", "value": "https://oauth.codef.io/oauth/token" },
    { "key": "client_id", "value": "ef27cfaa-10c1-4470-adac-60ba476273f9" },
    { "key": "client_secret", "value": "83160c33-9045-4915-86d8-809473cdf5c3" },
    { "key": "access_token", "value": "" },
    { "key": "connected_id", "value": "sandbox_connectedId" },
    { "key": "organization", "value": "0309" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 토큰이 없으면 요청 전에 자동으로 발급받습니다.",
          "if (pm.info.requestName !== '1. 토큰 발급' && !pm.collectionVariables.get('access_token')) {",
          "  const id = pm.collectionVariables.get('client_id');",
          "  const secret = pm.collectionVariables.get('client_secret');",
          "  const basic = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(id + ':' + secret));",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('oauth_url'),",
          "    method: 'POST',",
          "    header: {",
          "      'Content-Type': 'application/x-www-form-urlencoded',",
          "      'Authorization': 'Basic ' + basic",
          "    },",
          "    body: {",
          "      mode: 'urlencoded',",
          "      urlencoded: [",
          "        { key: 'grant_type', value: 'client_credentials' },",
          "        { key: 'scope', value: 'read' }",
          "      ]",
          "    }",
          "  }, (err, res) => {",
          "    if (err) { console.error('토큰 발급 실패', err); }",
          "    else { pm.collectionVariables.set('access_token', res.json().access_token); }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. 토큰 발급",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.test('access_token 발급됨', () => pm.expect(res.access_token).to.be.a('string'));",
              "pm.collectionVariables.set('access_token', res.access_token);",
              "console.log('토큰 저장 완료, 유효기간(초):', res.expires_in);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{client_id}}", "type": "string" },
            { "key": "password", "value": "{{client_secret}}", "type": "string" }
          ]
        },
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials" },
            { "key": "scope", "value": "read" }
          ]
        },
        "url": "{{oauth_url}}"
      }
    },
    {
      "name": "2. 카드 목록 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 토큰 만료(401)면 비워 두고, 다음 요청 때 자동으로 다시 발급받게 합니다.",
              "if (pm.response.code === 401) {",
              "  pm.collectionVariables.set('access_token', '');",
              "  console.warn('토큰 만료 - 다시 Send 하세요.');",
              "} else {",
              "  // CODEF 응답은 URL 인코딩되어 있어서 디코딩해야 읽을 수 있습니다.",
              "  const data = JSON.parse(decodeURIComponent(pm.response.text().replace(/\\+/g, ' ')));",
              "  console.log(data);",
              "  pm.test('CODEF 결과 코드 CF-00000', () => pm.expect(data.result.code).to.eql('CF-00000'));",
              "",
              "  const cards = Array.isArray(data.data) ? data.data : [data.data];",
              "  const template = `",
              "    <h3>{{message}} ({{code}})</h3>",
              "    <table border='1' cellpadding='6' style='border-collapse:collapse'>",
              "      <tr><th>카드명</th><th>종류</th><th>카드번호</th><th>교통카드</th></tr>",
              "      {{#each cards}}",
              "      <tr><td>{{resCardName}}</td><td>{{resCardType}}</td><td>{{resCardNo}}</td><td>{{resTrafficYN}}</td></tr>",
              "      {{/each}}",
              "    </table>",
              "    <h4>디코딩된 전체 응답</h4>",
              "    <pre>{{json}}</pre>`;",
              "  pm.visualizer.set(template, {",
              "    message: data.result.message,",
              "    code: data.result.code,",
              "    cards: cards,",
              "    json: JSON.stringify(data, null, 2)",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{access_token}}", "type": "string" }
          ]
        },
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"connectedId\": \"{{connected_id}}\",\n  \"organization\": \"{{organization}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/v1/kr/card/p/account/card-list"
      }
    }
  ]
}
