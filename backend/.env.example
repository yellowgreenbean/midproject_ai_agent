DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/midproject

# CORS 로 허용할 화면 주소 (쉼표로 구분, "*" 불가 — 로그인 쿠키를 주고받기 때문). 없으면 app/config.py 기본값
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 로그인 쿠키에 Secure 를 붙일지 — https 로 배포할 때만 true (내 PC 의 http 에서는 false 라야 쿠키가 저장됨)
COOKIE_SECURE=false

# 개발용: true 면 로그인 없이 X-User-Id 헤더로 회원을 정한다(Swagger·curl 시험용). 배포 환경에서는 절대 켜지 말 것
AUTH_DEV_HEADER=false

# 시험용 로그인 값 — scripts/seed_scenarios.py 가 Argon2id 해시로 만들어 넣는다. 실제 비밀번호를 쓰지 말 것
SEED_PASSWORD=seed-test-pass-2026
SEED_PIN=258013
